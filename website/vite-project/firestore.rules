rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && role() == 'superadmin';
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create, update, delete: if isSuperAdmin();
    }

    match /notices/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isSuperAdmin() || role() == 'notice_admin');
    }

    match /placements/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isSuperAdmin() || role() == 'tnp_admin');
    }

    match /events/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isSuperAdmin() || role() == 'event_admin');
    }

    match /timetable/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isSuperAdmin() || role() == 'timetable_admin');
    }

    match /timetableSubjects/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isSuperAdmin() || role() == 'timetable_admin');
    }
  }
}
